# USOTest4's base (2026-10-19): Tower's twin on Unraid 7.3.3 — the apps server - Docker on, Kopia (the container «kopia», filesystem repository), ZFS
# cache, xfs + zfs array. Read by tools/scenarios/base.sh (bash, KEY=value).
HOST_IP=192.168.7.193
DOCKER=yes
# the office's first setup (base.sh --make): who is hired (the Team Lead always is), Mr. Backupsy's default for
# everything (the setup page's «Automatic»), his schedule, Ms. Moverelli's limit X and her schedule (the joint run),
# the shares with rules of hers (<share>:<days> - moved only once that old), Mr. Restori's drill
HIRE="advisor backup cleanup logs moverelli restore snapshot watchman"
BACKUP_PRESET=auto
BACKUP_CRON="30 4 * * *"
MOVERELLI_X=80
MOVERELLI_CRON="0 3 * * *"
MOVERELLI_RULES="uso-yes:30"
DRILL=weekly
# Unraid as the base wants it (checked and reported; set only through the states' helpers)
MOVER_SCHEDULE=""
LOCALTIME=/usr/share/zoneinfo/Europe/Berlin
# carried into the new data folder from the newest one set aside that has the file: the partner door's pairs, so the
# canary (USOPartner) can still send to Tower - the base office itself never sends there (coordinator, 2026-10-18)
CARRY=""
