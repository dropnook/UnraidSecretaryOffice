# Tower's «mixed» base profile (INV-TRUTH, 2026-10-25): Tower as a real, messy server — read by tools/scenarios/base.sh
# after base.env (`base.sh --profile mixed`, a scenario's `# base-profile: mixed`, `run.sh --profile mixed`), and by
# tools/scenarios/base-mixed.sh. Made once from the Mac with tools/scenarios/mixed-make.sh (kept as <data>.base-mixed/).
#
# What it adds to the default base (each an object of its own, made by base-mixed.sh and taken away again by the next
# default reset, so the default base stays exactly as it was):
#   VMs     uso-vm-agent, uso-vm-plain in datasets of their own (the base's); uso-vm-shared a plain folder in domains' own
#           dataset; uso-vm-xfs on the share uso-vmxfs on disk1 (XFS: no snapshot can hold it); uso-vm-plain running and
#           never held (prepare none)
#   apps    the base's: in appdata (Emby, Nextcloud, …), Jellyfin in a dataset of its own, Node-Exporter without data,
#           immich a compose stack
#   shares  media on disk1 (XFS) and disk2 (ZFS) at «local» — half of it can't be snapshotted; uso-arr (disk1, XFS) at
#           «local» — none of it can; nextcloud and uso-only offsite (Kopia on); appdata, domains, nextcloud and
#           uso-vm-agent sent to USOTest4 (a partner pair over the LAN, the office's own pairing)
#   not here: a share on two pools — Tower has one pool (cache, two NVMe); a second pool needs vdisks from the coordinator
CARRY=""
MIXED_PARTNER_IP=192.168.7.193
MIXED_PARTNER_ALIAS=uso-test4
MIXED_PARTNER_RECEIVE='{"pool":"cache","quota_gb":40,"retention":"7 4 6"}'
MIXED_VMS="xfs shared"
MIXED_RUNNING="uso-vm-plain"
# Mr. Backupsy's Apply on a plan made anew (BK-APPLY's keys; @ID@ = the pair with USOTest4)
MIXED_DECISIONS=(
    'share|nextcloud|mode=kopia'
    'share|uso-only|mode=kopia'
    'share|media|mode=snapshot'
    'share|uso-arr|mode=snapshot'
    'share|appdata|partner=["@ID@"]'
    'share|domains|partner=["@ID@"]'
    'share|nextcloud|partner=["@ID@"]'
    'vm|uso-vm-agent|partner=["@ID@"]'
    'vm|uso-vm-plain|prepare=none'
    'vm|uso-vm-shared|mode=snapshot'
    'vm|uso-vm-shared|prepare=pause'
    'vm|uso-vm-xfs|mode=snapshot'
)
# (uso-vm-xfs's prepare is the page's: a VM no snapshot holds is never held — its select greyed at «none»)
# the profile's own shares (base.sh's step 2 leaves them as base shares while the server is on this profile)
PROFILE_SHARES="uso-vmxfs"
