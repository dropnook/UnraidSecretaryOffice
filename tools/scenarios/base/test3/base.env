# USOTest3VM's base (playbook §3): the plain server - Docker off, no VMs, btrfs cache, Unraid's mover on schedule,
# the time zone broken on purpose (TM-UTC-BROKEN: the Zurich zone file is missing on 7.3/7.4, the server runs UTC).
HOST_IP=192.168.7.197
DOCKER=no
HIRE="advisor backup cleanup logs moverelli restore snapshot watchman"
BACKUP_PRESET=auto
BACKUP_CRON="30 4 * * *"
MOVERELLI_X=80
MOVERELLI_CRON="0 3 * * *"
MOVERELLI_RULES="uso-yes"
DRILL=weekly
MOVER_SCHEDULE="40 3 * * *"
LOCALTIME=/usr/share/zoneinfo/Europe/Zurich
CARRY=""
