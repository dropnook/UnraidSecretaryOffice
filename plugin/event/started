#!/bin/bash
# The array runs (end of cmdStart): the night shift ends (if it was on), the
# office's agent starts working and takes the night's entries into the night
# watchman's book. The array's start becomes a line in his book. When a backup
# run the array stop ended left containers stopped, Nextcloud in maintenance
# mode or VMs shut down (its notes), backup.sh --recover is handed to atd and
# brings them back (engine 2.25) - here only a look at the notes, emhttp waits.
bash /usr/local/emhttp/plugins/unraid-secretary-office/scripts/agent.sh array started >/dev/null 2>&1
exit 0
