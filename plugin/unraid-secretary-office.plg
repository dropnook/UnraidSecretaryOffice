<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "unraid-secretary-office">
<!ENTITY author    "dropnook">
<!ENTITY version   "@VERSION@">
<!ENTITY office    "@OFFICE_VERSION@">
<!ENTITY github    "dropnook/UnraidSecretaryOffice">
<!ENTITY pluginURL "https://github.com/&github;/releases/latest/download/&name;.plg">
<!ENTITY package   "&name;-&version;.txz">
<!ENTITY packageURL "https://github.com/&github;/releases/download/v&office;/&package;">
<!ENTITY sha256    "@SHA256@">
<!ENTITY launch    "SecretaryOffice">
<!ENTITY dir       "/usr/local/emhttp/plugins/&name;">
<!ENTITY flash     "/boot/config/plugins/&name;">
]>
<!--
  Unraid Secretary Office - an office for your Unraid server.
  https://github.com/dropnook/UnraidSecretaryOffice (GPL-3.0-or-later)

  This is the template: plugin/build.sh (run by a GitHub Action when a release
  is published) fills in version, office version, SHA256 and changes.
  Unraid 7.3 or newer; Unraid 8 is not supported for now (max).
-->
<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;"
        pluginURL="&pluginURL;" support="@SUPPORT@"
        icon="unraid-secretary-office.png" min="7.3.2" max="7.99.99">

<CHANGES>
@CHANGES@
</CHANGES>

<!-- the package: everything in RAM under /usr/local/emhttp/plugins/&name; -->
<FILE Name="&flash;/&package;">
<URL>&packageURL;</URL>
<SHA256>&sha256;</SHA256>
</FILE>

<!-- install (also at every boot) -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
set -u
# an update over SSH: the agent started below (and an older agent.sh started again if the swap fails) carries nothing of
# that login - pam removes XDG_RUNTIME_DIR at the logout and every docker exec of the office fails then (agent.sh's CLEAN_ENV)
unset XDG_RUNTIME_DIR SSH_CLIENT SSH_CONNECTION SSH_TTY SSH_AUTH_SOCK
name=unraid-secretary-office
dir=/usr/local/emhttp/plugins/$name
plugins=${dir%/*}
flash=/boot/config/plugins/$name
run=/var/run/$name
docker=/boot/config/docker.cfg
package="$flash/$name-@VERSION@.txz"

# The office's long jobs run outside the agent (atd, cron) from the files in the plugin folder - a backup run or the
# backup setup, Mr. Restori's restore or drill, Jack Streamer's EmbyCache or gather, Ms. Moverelli's Smart Mover: don't pull the files away under them
# (the agent and its night shift are stopped below; short jobs end on their own). One pattern, against the command line
# (the same in the remove below).
jobs="^((/usr)?(/bin/)?bash $dir/backup/(backup|setup)\.sh|([^ ]*/)?php $dir/agent/agent\.php job (restore|restore-drill|embycache|gather|moverelli)( |\$))"
if pgrep -f "$jobs" >/dev/null 2>&1; then
    echo "The office is busy right now: a backup run, a restore or restore drill, one of Jack Streamer's runs or Ms. Moverelli's."
    echo "Update the plugin once it is done."
    exit 1
fi

# The new version is unpacked BESIDE the running one and checked before anything else happens: a package that can't be
# unpacked (RAM full, a damaged file) leaves the office as it was - its agent, its page, the job.sh of the cron lines -
# and says so. Then the swap: the agent stopped, the old folder moved aside and the new one into its place (two renames:
# the partners' door, scripts/partner-door.sh, is gone for that moment only), the new agent started, the old folder
# removed. Both wait one level down (<name>.new-<pid>/<name>, <name>.old-<pid>/<name>), where Unraid looks for no pages.
# At boot there is no old folder: the same without the swap (nothing here needs the array or var.ini). What an install
# that was cut off left goes first.
for left in "$plugins/$name".new-* "$plugins/$name".old-*; do
    pid=${left##*-}
    if [ -d "$left" ] && [ ! -L "$left" ] && { ! [[ "$pid" =~ ^[0-9]+$ ]] || ! kill -0 "$pid" 2>/dev/null; }; then
        rm -rf "$left"
    fi
done
new="$plugins/$name.new-$$"
old="$plugins/$name.old-$$"
mkdir -p "$plugins"
if ! mkdir "$new" || ! tar -xJf "$package" -C "$new" || [ ! -f "$new/$name/agent/agent.php" ] || [ ! -f "$new/$name/scripts/agent.sh" ] \
   || [ ! -f "$new/$name/scripts/partner-door.sh" ]; then
    rm -rf "$new"
    echo "The package could not be unpacked: $package"
    echo "Nothing was changed - the office keeps running as it was."
    exit 1
fi

# the night watchman's round may end what it is telling first (15 s at most; agent.sh's watchman_round_wait - the
# running version's agent.sh may be older and kill it in the middle: told again by the new agent, batch E O1)
round_end=$((SECONDS + 15))
for l in "$run"/watchman-round-*.lock; do
    [ -f "$l" ] && [ ! -L "$l" ] && [ "$SECONDS" -lt "$round_end" ] && flock -s -w $((round_end - SECONDS)) "$l" true 2>/dev/null
done
[ -f "$dir/scripts/agent.sh" ] && bash "$dir/scripts/agent.sh" stop
if [ -e "$dir" ] || [ -L "$dir" ]; then
    if ! mkdir "$old" || ! mv "$dir" "$old/$name"; then
        rm -rf "$new"
        rmdir "$old" 2>/dev/null
        [ -f "$dir/scripts/agent.sh" ] && bash "$dir/scripts/agent.sh" start
        echo "The running version could not be moved aside: $dir"
        echo "Nothing was changed - the office keeps running as it was."
        exit 1
    fi
fi
if ! mv "$new/$name" "$dir"; then
    [ -e "$old/$name" ] && mv "$old/$name" "$dir"
    rm -rf "$new"
    rmdir "$old" 2>/dev/null
    [ -f "$dir/scripts/agent.sh" ] && bash "$dir/scripts/agent.sh" start
    echo "The new version could not be put into place: $dir"
    echo "Nothing was changed - the office keeps running as it was."
    exit 1
fi
rmdir "$new"
# from here on the new version stays, whatever happens: half of each would be worse
find "$flash" -maxdepth 1 -name "$name-*.txz" ! -name "$name-@VERSION@.txz" -delete

# the one setting on the flash: where the data lives (appdata comes with the array)
appdata=$(sed -n 's/^DOCKER_APP_CONFIG_PATH="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$docker" 2>/dev/null | tail -n 1)
appdata=${appdata:-/mnt/user/appdata}
if [ ! -f "$flash/$name.cfg" ]; then
    printf 'DATA_DIR="%s/UnraidSecretaryOffice/data"\n' "${appdata%/}" > "$flash/$name.cfg"
fi

# The office's own folder above its data folder (the data folder at its default place, <appdata>/UnraidSecretaryOffice):
# root:root 0755, only that one folder, never what is in it (the data files keep their owner) - nobody else may put a
# data folder of their own in its place. Entered first and the folder entered checked to be the one looked at: never
# through a link. A data folder elsewhere: the folder above it is the user's, left alone. At boot appdata isn't there
# yet: the agent does the same at its start (agent/lib/house.php officeHomeOwn()).
data=$(sed -n 's/^DATA_DIR="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$flash/$name.cfg" 2>/dev/null | tail -n 1)
home="${appdata%/}/UnraidSecretaryOffice"
if [ "${data%/}" = "$home/data" ] && [ -d "$home" ] && [ ! -L "$home" ]; then
    ino=$(stat -c %d:%i "$home" 2>/dev/null)
    ( cd "$home" 2>/dev/null && [ -n "$ino" ] && [ "$(stat -c %d:%i .)" = "$ino" ] && chown root:root . && chmod 0755 . ) \
        || echo "Could not make $home root:root 0755 - the office tries again at its start."
fi

# the office's entry in Unraid as chosen in its ⋯ menu: label and place (MENU_NAME, MENU_PLACE in the .cfg)
php -r 'require $argv[1] . "/src/place.php"; officeMenuPageApply($argv[1], officeMenuName(), officeMenuPlace());' "$dir" || true

# the agent - or, while the array isn't started yet (at boot; an encrypted array waits for its key), the night
# watchman's night shift (RAM and flash only); event/started hands over to the agent. The agent checks in within a
# few seconds (its heartbeat in RAM, written at its start): said when it doesn't - the new version stays anyway.
started=$(date +%s)
if ! bash "$dir/scripts/agent.sh" start; then
    echo "The new version is in place, but its agent did not start: bash $dir/scripts/agent.sh restart"
elif bash "$dir/scripts/agent.sh" status >/dev/null 2>&1; then
    in=no
    for i in $(seq 1 20); do
        if [ "$(stat -c %Y "$run/agent.json" 2>/dev/null || echo 0)" -ge "$started" ] && grep -q '"running":true' "$run/agent.json" 2>/dev/null; then
            in=yes
            break
        fi
        sleep 0.5
    done
    [ "$in" = yes ] || echo "The new version is in place, but its agent hasn't checked in yet - what it said: /var/log/$name.log"
fi
[ -d "$old" ] && rm -rf "$old"

where=$(php -r 'require $argv[1] . "/src/place.php"; echo ["settings" => "Settings > User Utilities > ", "button" => "the button in Unraid'"'"'s header: "][officeMenuPlace()] ?? "the menu bar: ", officeMenuName();' "$dir" 2>/dev/null)
echo ""
echo "-----------------------------------------------------------"
echo " Unraid Secretary Office @OFFICE_VERSION@ (plugin @VERSION@) is installed."
echo " Open it in ${where:-the menu bar: Sekretariat}"
echo "-----------------------------------------------------------"
echo ""
echo " All done - you can close this window."
echo ""
]]>
</INLINE>
</FILE>

<!-- remove: the code goes, your data stays (the schedules put aside) -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
name=unraid-secretary-office
dir=/usr/local/emhttp/plugins/$name
flash=/boot/config/plugins/$name
keys=/boot/config/ssh/root/authorized_keys
data=$(sed -n 's/^DATA_DIR="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$flash/$name.cfg" 2>/dev/null | tail -n 1)

# Not while one of the office's long jobs runs from the plugin folder (the same pattern as the install's): a remove
# that fails keeps the plugin installed.
jobs="^((/usr)?(/bin/)?bash $dir/backup/(backup|setup)\.sh|([^ ]*/)?php $dir/agent/agent\.php job (restore|restore-drill|embycache|gather|moverelli)( |\$))"
if pgrep -f "$jobs" >/dev/null 2>&1; then
    echo "The office is busy right now: a backup run, a restore or restore drill, one of Jack Streamer's runs or Ms. Moverelli's."
    echo "Nothing was removed - remove the plugin once it is done."
    exit 1
fi

# What the office holds, let go while its scripts are still there (they go with the plugin: nothing would release it
# at the next array stop) - the agent and its night shift, Mr. Restori's drill or restore, a partner's transfer through
# the door and the door's records in RAM, the backup engine's snapshot mounts kept between runs, what Mr. Restori pulled
# from a partner (agent.sh release, the same as at an array stop).
[ -f "$dir/scripts/agent.sh" ] && bash "$dir/scripts/agent.sh" release

# The USO network (when this server joined it): the node leaves its tailnet, its helper, sshd, namespace, state and cron
# line go - nothing of it is left behind (scripts/usonet.sh leave).
usonet=
[ -d "$flash/usonet" ] && usonet=yes
[ -f "$dir/scripts/usonet.sh" ] && bash "$dir/scripts/usonet.sh" leave

# The office's schedules (the nightly backup, Jack Streamer's runs, Ms. Snapshotini's plans) put aside on the flash, not
# deleted: installed again, the agent puts them back at its start (agent/lib/migrate.php officeCronBack()). An aside of
# an earlier remove makes way for them. The agent's watch line goes (agent.sh writes it anew at every start).
aside=
if [ -f "$flash/$name.cron" ] && [ ! -L "$flash/$name.cron" ]; then
    rm -f "$flash/$name.cron".removed-*
    stamp=$(date +%Y%m%d-%H%M%S)
    mv -f "$flash/$name.cron" "$flash/$name.cron.removed-$stamp" && aside="$flash/$name.cron.removed-$stamp"
fi
if [ -n "$aside" ] || [ -f "$flash/agent-watch.cron" ]; then
    rm -f "$flash/agent-watch.cron"
    bash /usr/local/sbin/update_cron
fi
# partner offices: the office's lines (comment uso-partner:<id>, a restore ticket's uso-ticket:<id>) out of root's authorized_keys - every other line
# byte for byte, a new file + rename, never through a link - and the pairs' keys and pinned host keys off the flash
partners=
if [ -f "$keys" ] && [ ! -L "$keys" ] && grep -q 'uso-\(partner\|ticket\):[0-9a-f]\{8\}' "$keys" 2>/dev/null; then
    partners=yes
    php -r 'umask(077); $f = $argv[1]; $t = (string) file_get_contents($f); $o = "";
        foreach (preg_split("/(?<=\n)/", $t) as $c) { if ($c !== "" && !preg_match("/(?:^|[ \t])uso-(?:partner|ticket):[0-9a-f]{8}\r?\n?$/D", $c)) { $o .= $c; } }
        $tmp = dirname($f) . "/.authorized_keys.uso-" . getmypid();
        if ($o !== $t && !is_link($f) && file_put_contents($tmp, $o) === strlen($o)) { rename($tmp, $f); } else { @unlink($tmp); }' "$keys" || true
fi
[ -d "$flash/partners" ] && [ -n "$(ls -A "$flash/partners" 2>/dev/null)" ] && partners=yes
rm -rf "$flash/partners"
rm -rf "$dir"
rm -f "$flash"/$name-*.txz "$flash/watchman-mirror.json"

echo ""
echo "-----------------------------------------------------------"
echo " Unraid Secretary Office has been removed."
if [ -n "$partners" ]; then
    echo " Its partnerships with other offices have ended: their keys"
    echo " and their lines in root's authorized_keys are gone - pair"
    echo " again after a new install. Copies already made stay."
fi
if [ -n "$usonet" ]; then
    echo " It left the USO network: its node is out of the tailnet"
    echo " (if it could reach it - else remove it there) and nothing"
    echo " of the network is left on this server."
fi
if [ -n "$aside" ]; then
    echo " Its schedules (nightly backup, Jack Streamer's runs) were put"
    echo " aside: $aside -"
    echo " installed again, the office puts them back."
fi
echo " Kept: its data (${data:-appdata/UnraidSecretaryOffice/data}),"
echo " the share UnraidSecretaryOffice, the settings in $flash"
echo " and whatever the desks set up on the server (snapshots,"
echo " Ms. Dustdevil's storeroom). Delete them yourself if you"
echo " don't want them any more."
echo "-----------------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

</PLUGIN>
