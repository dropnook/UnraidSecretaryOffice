<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
<!ENTITY name      "unraid-secretary-office">
<!ENTITY author    "vipermark2">
<!ENTITY version   "@VERSION@">
<!ENTITY office    "@OFFICE_VERSION@">
<!ENTITY github    "vipermark2/UnraidSecretaryOffice">
<!ENTITY pluginURL "https://github.com/&github;/releases/latest/download/&name;.plg">
<!ENTITY package   "&name;-&version;.txz">
<!ENTITY packageURL "https://github.com/&github;/releases/download/v&office;/&package;">
<!ENTITY sha256    "@SHA256@">
<!ENTITY launch    "SecretaryOffice">
<!ENTITY dir       "/usr/local/emhttp/plugins/&name;">
<!ENTITY flash     "/boot/config/plugins/&name;">
]>
<!--
  Unraid Secretary Office - a small office for your Unraid server.
  https://github.com/vipermark2/UnraidSecretaryOffice (GPL-3.0-or-later)

  This is the template: plugin/build.sh (run by a GitHub Action when a release
  is published) fills in version, office version, SHA256 and changes.
  Unraid 7.3 or newer; Unraid 8 is not supported for now (max).
-->
<PLUGIN name="&name;" author="&author;" version="&version;" launch="&launch;"
        pluginURL="&pluginURL;" support="@SUPPORT@"
        icon="unraid-secretary-office.png" min="7.3.0" max="7.99.99">

<CHANGES>
@CHANGES@
</CHANGES>

<!-- the package: everything in RAM under /usr/local/emhttp/plugins/&name; -->
<FILE Name="&flash;/&package;">
<URL>&packageURL;</URL>
<SHA256>&sha256;</SHA256>
</FILE>

<!-- install (also at every boot) -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
set -u
name=unraid-secretary-office
dir=/usr/local/emhttp/plugins/$name
flash=/boot/config/plugins/$name
package="$flash/$name-@VERSION@.txz"

# A backup run uses the engine's files in the plugin folder: don't pull them away.
if pgrep -f "^(/usr)?(/bin/)?bash $dir/backup/(backup|setup)\.sh" >/dev/null 2>&1; then
    echo "A backup run of the office is active right now. Update the plugin once it is done."
    exit 1
fi

[ -x "$dir/scripts/agent.sh" ] && bash "$dir/scripts/agent.sh" stop

# a clean folder, so files left out of a new version are really gone
rm -rf "$dir"
mkdir -p /usr/local/emhttp/plugins
if ! tar -xJf "$package" -C /usr/local/emhttp/plugins; then
    echo "The package could not be unpacked: $package"
    exit 1
fi
find "$flash" -maxdepth 1 -name "$name-*.txz" ! -name "$name-@VERSION@.txz" -delete

# the one setting on the flash: where the data lives (appdata comes with the array)
if [ ! -f "$flash/$name.cfg" ]; then
    appdata=$(sed -n 's/^DOCKER_APP_CONFIG_PATH="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' /boot/config/docker.cfg 2>/dev/null | tail -n 1)
    appdata=${appdata:-/mnt/user/appdata}
    printf 'DATA_DIR="%s/UnraidSecretaryOffice/data"\n' "${appdata%/}" > "$flash/$name.cfg"
fi

# the office's label in Unraid's menu bar, as chosen in the office's ⋯ menu (MENU_NAME in the .cfg)
php -r 'require $argv[1] . "/src/place.php"; officeMenuPageApply($argv[1], officeMenuName());' "$dir" || true

bash "$dir/scripts/agent.sh" start

menu=$(php -r 'require $argv[1] . "/src/place.php"; echo officeMenuName();' "$dir" 2>/dev/null)
echo ""
echo "-----------------------------------------------------------"
echo " Unraid Secretary Office @OFFICE_VERSION@ (plugin @VERSION@) is installed."
echo " Open it in Unraid's menu bar: ${menu:-Sekretariat}"
echo "-----------------------------------------------------------"
echo ""
echo " All done - you can close this window."
echo ""
]]>
</INLINE>
</FILE>

<!-- remove: the code goes, your data stays -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
name=unraid-secretary-office
dir=/usr/local/emhttp/plugins/$name
flash=/boot/config/plugins/$name
data=$(sed -n 's/^DATA_DIR="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' "$flash/$name.cfg" 2>/dev/null | tail -n 1)

[ -x "$dir/scripts/agent.sh" ] && bash "$dir/scripts/agent.sh" stop
if [ -f "$flash/$name.cron" ]; then
    rm -f "$flash/$name.cron"
    bash /usr/local/sbin/update_cron
fi
rm -rf "$dir"
rm -f "$flash"/$name-*.txz

echo ""
echo "-----------------------------------------------------------"
echo " Unraid Secretary Office has been removed."
echo " Kept: its data (${data:-appdata/UnraidSecretaryOffice/data}),"
echo " the share UnraidSecretaryOffice, the settings in $flash"
echo " and whatever the desks set up on the server (snapshots,"
echo " Ms. Dustdevil's storeroom). Delete them yourself if you"
echo " don't want them any more."
echo "-----------------------------------------------------------"
echo ""
]]>
</INLINE>
</FILE>

</PLUGIN>
