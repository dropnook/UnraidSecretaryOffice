# Copy to .env and adjust. Docker Compose reads .env from this folder.

# Where this repository lies on the server
OFFICE_DIR=/mnt/user/appdata/UnraidSecretaryOffice

# IP of the office on br0 (must be free in your LAN)
OFFICE_IP=192.168.1.59

# Time zone for the few dates the server formats itself
TZ=Europe/Zurich
