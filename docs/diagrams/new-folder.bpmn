<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_new_folder" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:process id="new_folder" name="A new folder in a share" isExecutable="false">
    <bpmn:startEvent id="S" name="New folder inside a share">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="G1" name="appdata or domains?">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T1" name="Inherits the share's level: offsite, local only or not backed up">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E1">
      <bpmn:incoming>F3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="G2" name="Which app or VM does it belong to?">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T2" name="Inherits the app's or VM's level: goes offsite too">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E2">
      <bpmn:incoming>F6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T3" name="Inherits the app's or VM's level: local only (a new one gets the preset)">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E3">
      <bpmn:incoming>F8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T4" name="Nothing to inherit: stays local and waits for your decision">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E4">
      <bpmn:incoming>F10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="G1" />
    <bpmn:sequenceFlow id="F2" name="No (data share)" sourceRef="G1" targetRef="T1" />
    <bpmn:sequenceFlow id="F3" sourceRef="T1" targetRef="E1" />
    <bpmn:sequenceFlow id="F4" name="Yes" sourceRef="G1" targetRef="G2" />
    <bpmn:sequenceFlow id="F5" name="one that goes offsite" sourceRef="G2" targetRef="T2" />
    <bpmn:sequenceFlow id="F6" sourceRef="T2" targetRef="E2" />
    <bpmn:sequenceFlow id="F7" name="a local-only or new one" sourceRef="G2" targetRef="T3" />
    <bpmn:sequenceFlow id="F8" sourceRef="T3" targetRef="E3" />
    <bpmn:sequenceFlow id="F9" name="none" sourceRef="G2" targetRef="T4" />
    <bpmn:sequenceFlow id="F10" sourceRef="T4" targetRef="E4" />
    <bpmn:textAnnotation id="A1">
      <bpmn:text>appdata and domains: where Unraid keeps the folders of apps and VMs (Docker and VM settings)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="AS1" sourceRef="G1" targetRef="A1" />
    <bpmn:textAnnotation id="A2">
      <bpmn:text>If appdata or domains itself is local only, it goes along after the next «Apply»</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="AS2" sourceRef="T2" targetRef="A2" />
  </bpmn:process>
