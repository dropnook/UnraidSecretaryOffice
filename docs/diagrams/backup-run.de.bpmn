<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_sicherung" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:signal id="Sig_array" name="Array wird gestoppt" />
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="Pool" name="Eine Sicherung" processRef="sicherung" />
    <bpmn:textAnnotation id="A2">
      <bpmn:text>Ohne Partner fällt dieser Schritt weg.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A1">
      <bpmn:text>Ab hier laufen Apps und VMs wieder - die Kopien brauchen keinen Stillstand.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A4">
      <bpmn:text>Ohne Kopia fällt dieser Schritt weg.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A3">
      <bpmn:text>Gilt in jedem Schritt: Herr Backupsi hört sofort auf und startet, was er angehalten hat.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A3_as" sourceRef="TA" targetRef="A3" />
    <bpmn:association id="A2_as" sourceRef="T7" targetRef="A2" />
    <bpmn:association id="A1_as" sourceRef="T6" targetRef="A1" />
    <bpmn:association id="A4_as" sourceRef="T8" targetRef="A4" />
  </bpmn:collaboration>
  <bpmn:process id="sicherung" isExecutable="false">
    <bpmn:laneSet id="LS">
      <bpmn:lane id="L4" name="Ausser Haus (Kopia)">
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>TA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EA</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>B1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L3" name="Partner-Sekretariat">
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2" name="Apps und VMs">
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L1" name="Herr Backupsi">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E0</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Zeitplan oder «Jetzt sichern»">
      <bpmn:outgoing>F0</bpmn:outgoing>
      <bpmn:timerEventDefinition id="S_t" />
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="G0" name="Läuft gerade eine Rückholung oder Übung?">
      <bpmn:incoming>F0</bpmn:incoming>
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="T0" name="Überspringen und melden">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E0">
      <bpmn:incoming>F2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T1" name="Umschauen: was ist da, was ist neu">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T3" name="VMs pausieren oder fahren herunter, Apps halten an (oder laufen weiter, je nach Einrichtung)">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T4" name="Pakete und Datenbank-Dumps">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T5" name="Snapshots: Shares, VMs, Flash">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T6" name="Apps und VMs starten wieder">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T7" name="Kopie zum Partner-Sekretariat (ZFS)">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T8" name="Upload ausser Haus (Kopia), Quelle für Quelle">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="TA" name="Sauber aufhören: nichts gelöscht, Apps und VMs laufen">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EA">
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="T9" name="Aufräumen: alte Snapshots nach Aufbewahrung">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T10" name="Ergebnis: Verlauf und Meldung">
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E" name="Sicherung fertig">
      <bpmn:incoming>F14</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="B1" name="Array wird gestoppt" attachedToRef="T8">
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:signalEventDefinition id="B1_s" signalRef="Sig_array" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="F0" sourceRef="S" targetRef="G0" />
    <bpmn:sequenceFlow id="F1" name="Ja" sourceRef="G0" targetRef="T0" />
    <bpmn:sequenceFlow id="F3" name="Nein" sourceRef="G0" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" sourceRef="T0" targetRef="E0" />
    <bpmn:sequenceFlow id="F4" sourceRef="T1" targetRef="T3" />
    <bpmn:sequenceFlow id="F5" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="F6" sourceRef="T4" targetRef="T5" />
    <bpmn:sequenceFlow id="F7" sourceRef="T5" targetRef="T6" />
    <bpmn:sequenceFlow id="F8" sourceRef="T6" targetRef="T7" />
    <bpmn:sequenceFlow id="F9" sourceRef="T7" targetRef="T8" />
    <bpmn:sequenceFlow id="F12" sourceRef="T8" targetRef="T9" />
    <bpmn:sequenceFlow id="F10" sourceRef="B1" targetRef="TA" />
    <bpmn:sequenceFlow id="F11" sourceRef="TA" targetRef="EA" />
    <bpmn:sequenceFlow id="F13" sourceRef="T9" targetRef="T10" />
    <bpmn:sequenceFlow id="F14" sourceRef="T10" targetRef="E" />
  </bpmn:process>
