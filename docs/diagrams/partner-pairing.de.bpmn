        <dc:Bounds x="730" y="270" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T4_di" bpmnElement="T4">
        <dc:Bounds x="950" y="90" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T5_di" bpmnElement="T5">
        <dc:Bounds x="950" y="450" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T6_di" bpmnElement="T6">
        <dc:Bounds x="1170" y="450" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T7_di" bpmnElement="T7">
        <dc:Bounds x="1370" y="450" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T8_di" bpmnElement="T8">
        <dc:Bounds x="1370" y="630" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_di" bpmnElement="E">
        <dc:Bounds x="1612" y="652" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1570" y="695" width="120" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A1_di" bpmnElement="A1">
        <dc:Bounds x="520" y="355" width="760" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A2_di" bpmnElement="A2">
        <dc:Bounds x="1560" y="402" width="230" height="46" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A3_di" bpmnElement="A3">
        <dc:Bounds x="1000" y="640" width="340" height="40" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
        <di:waypoint x="268" y="130" />
        <di:waypoint x="320" y="130" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2">
        <di:waypoint x="470" y="130" />
