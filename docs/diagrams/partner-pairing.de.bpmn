<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Defs_partner_pairing" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.51.1">
  <bpmn:collaboration id="Collab">
    <bpmn:participant id="Pool" name="Ein Partner-Sekretariat" processRef="partner_pairing" />
    <bpmn:textAnnotation id="A1">
      <bpmn:text>Die Zustimmung ist die Partnerschaft: die Tür nimmt jede Einheit des Partners an, bis zur Obergrenze, jederzeit. Kein Block trägt ein Geheimnis.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A2">
      <bpmn:text>Nur eigene ZFS-Datasets reisen. Nach dem ersten Mal nur, was sich geändert hat, verschlüsselt über SSH.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A3">
      <bpmn:text>Eine nie gesehene Einheit trägt auf der Karte den Chip «neu»; die Partnerschaft beenden schliesst die Tür. Die Kopien bleiben.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="A1_as" sourceRef="T3" targetRef="A1" />
    <bpmn:association id="A2_as" sourceRef="T6" targetRef="A2" />
    <bpmn:association id="A3_as" sourceRef="T8" targetRef="A3" />
  </bpmn:collaboration>
  <bpmn:process id="partner_pairing" isExecutable="false">
    <bpmn:laneSet id="Lanes">
      <bpmn:lane id="L1" name="Server A — Teamchef">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L2" name="Server B — Teamchef">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L3" name="Server A — Herr Backupsi">
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L4" name="Server B — die Tür">
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="«Partner hinzufügen…»">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="T1" name="BLOCK-A: Id, Adresse, Host-Schlüssel, der Paar-Schlüssel">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T2" name="«Partner annehmen…»: Pool, Obergrenze, Aufbewahrung, wecken">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T3" name="Die Tür-Zeile geschrieben; BLOCK-B und der Sicherheitscode">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T4" name="«Antwort des Partners einfügen» — die Codes stimmen">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T5" name="Stufe «lokal + Partner» pro Share und VM">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T6" name="Übernehmen — settings.ini: partner = &lt;id&gt;">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T7" name="Jedes Backup: die ZFS-Snapshots durch die Tür">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="T8" name="Nimmt jede Einheit an bis zur Obergrenze, behält sie nach eigener Aufbewahrung">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="E" name="Die Kopien beim Partner">
      <bpmn:incoming>F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="T1" />
    <bpmn:sequenceFlow id="F2" name="bei B einfügen" sourceRef="T1" targetRef="T2" />
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="T3" />
    <bpmn:sequenceFlow id="F4" name="bei A einfügen" sourceRef="T3" targetRef="T4" />
    <bpmn:sequenceFlow id="F5" sourceRef="T4" targetRef="T5" />
    <bpmn:sequenceFlow id="F6" sourceRef="T5" targetRef="T6" />
    <bpmn:sequenceFlow id="F7" sourceRef="T6" targetRef="T7" />
    <bpmn:sequenceFlow id="F8" name="SSH" sourceRef="T7" targetRef="T8" />
    <bpmn:sequenceFlow id="F9" sourceRef="T8" targetRef="E" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab">
      <bpmndi:BPMNShape id="Pool_di" bpmnElement="Pool" isHorizontal="true">
        <dc:Bounds x="160" y="40" width="1640" height="720" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L1_di" bpmnElement="L1" isHorizontal="true">
        <dc:Bounds x="190" y="40" width="1610" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L2_di" bpmnElement="L2" isHorizontal="true">
        <dc:Bounds x="190" y="220" width="1610" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L3_di" bpmnElement="L3" isHorizontal="true">
        <dc:Bounds x="190" y="400" width="1610" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L4_di" bpmnElement="L4" isHorizontal="true">
        <dc:Bounds x="190" y="580" width="1610" height="180" />
